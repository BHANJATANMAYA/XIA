# xia Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.


# DuckDuckGo works with NO key — it is the default free provider.
# Add a key below only if you want better/more reliable results.

# SerpAPI — https://serpapi.com (100 free searches/month)
# SERPAPI_KEY=your_key_here

# Tavily — https://tavily.com (1000 free searches/month, built for AI)
# TAVILY_API_KEY=your_key_here

# ── Model override ────────────────────────────────────────────
# XAI_MODEL=llama3

# ── Debug mode ────────────────────────────────────────────────
# XIA_DEBUG=true
